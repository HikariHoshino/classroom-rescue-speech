# ===== 后端 .env 样例：复制为 .env 并填入本人配置，不用的项可删除 =====
# 密钥仅放后端，禁止提交真实密钥；前端不使用 VITE_ 前缀存放服务密钥

# --- ASR 语音识别（2号，火山引擎流式识别）---
# 新版控制台：只填 ASR_API_KEY，ASR_APP_ID 留空
# 旧版控制台：ASR_APP_ID 填 APP ID，ASR_API_KEY 填 Access Token
ASR_APP_ID=
ASR_API_KEY=
ASR_RESOURCE_ID=volc.bigasr.sauc.duration
# 留空使用真实服务；联调用本地模拟服务填 ws://localhost:3101
ASR_WS_URL=

# --- LLM 大模型（3号）---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
